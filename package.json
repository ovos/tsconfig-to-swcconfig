{
	"name": "@ovos-media/tsconfig-to-swcconfig",
	"version": "3.0.0-mod.0",
	"description": "Convert tsconfig to swc config",
	"keywords": [
		"swc",
		"tsconfig",
		"converter",
		"config"
	],
	"homepage": "https://github.com/songkeys/tsconfig-to-swcconfig#readme",
	"bugs": {
		"url": "https://github.com/songkeys/tsconfig-to-swcconfig/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/songkeys/tsconfig-to-swcconfig.git"
	},
	"license": "MIT",
	"author": "Songkeys",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"t2s": "dist/cli.js",
		"tsconfig-to-swcconfig": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"format": "biome format . --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"prepack": "npm run build",
		"test": "npm run build && node --test test/*.test.mjs"
	},
	"simple-git-hooks": {
		"pre-commit": "npm run format && npm run lint:fix"
	},
	"dependencies": {
		"@fastify/deepmerge": "^3.2.1",
		"@swc/types": "^0.1.28",
		"get-tsconfig": "^4.14.3"
	},
	"peerDependencies": {
		"@swc/core": "^1.16.2"
	},
	"peerDependenciesMeta": {
		"@swc/core": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@swc/core": "^1.16.2",
		"@tsconfig/node22": "^22.0.6",
		"@types/node": "^22.20.3",
		"@typescript/typescript6": "^6.0.2",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^7.0.2"
	}
}
