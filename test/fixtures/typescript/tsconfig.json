{
	"compilerOptions": {
		"target": "es2025",
		"lib": ["es2025", "esnext.decorators", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"useDefineForClassFields": false,
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"rootDir": "."
	},
	"include": ["*.mts"]
}
